{
  "name": "workerlysia",
  "version": "0.0.1",
  "private": true,
  "description": "A modern starter kit for building type-safe APIs with Elysia on Cloudflare Workers",
  "homepage": "https://github.com/DobroslavRadosavljevic/workerlysia#readme",
  "bugs": {
    "url": "https://github.com/DobroslavRadosavljevic/workerlysia/issues"
  },
  "license": "MIT",
  "author": "Dobroslav Radosavljevic <dobroslav.radosavljevic@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DobroslavRadosavljevic/workerlysia.git"
  },
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "lint": "ultracite check",
    "format": "ultracite fix",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run lint && bun run typecheck && bun run test && bun audit"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.15",
    "effect": "^4.0.0-beta.83",
    "elysia": "^1.4.29",
    "file-type": "22.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@effect/vitest": "4.0.0-beta.83",
    "@elysiajs/eden": "^1.4.9",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/bun": "^1.3.14",
    "@types/service-worker-mock": "^2.0.4",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.103.0"
  },
  "overrides": {
    "ajv": "^8.20.0",
    "fast-uri": "^3.1.2",
    "file-type": "22.0.1",
    "js-yaml": "^4.2.0"
  },
  "packageManager": "bun@1.3.11"
}
